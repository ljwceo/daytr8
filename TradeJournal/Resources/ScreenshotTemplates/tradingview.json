{
  "formatVersion": 1,
  "id": "tradingview",
  "name": "TradingView",
  "priority": 5,
  "keywords": [
    "tradingview",
    "paper trading",
    "avg fill price"
  ],
  "fields": {
    "symbol": {
      "patterns": [
        "\\bsymbol\\b\\s*[:=]?\\s*([A-Z0-9_]+:[A-Z0-9!.]+|[A-Z0-9!.]{2,12})",
        "\\b([A-Z][A-Z0-9_]{1,14}:[A-Z][A-Z0-9!.]{1,11})"
      ]
    },
    "direction": {
      "patterns": [
        "\\bside\\b\\s*[:=]?\\s*(long|short|buy|sell)\\b",
        "(?m)^\\s*(long|short|buy|sell)\\s+[0-9]"
      ]
    },
    "quantity": {
      "patterns": [
        "\\b(?:qty|quantity)\\b\\s*[:=]?\\s*([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])",
        "(?m)^\\s*(?:long|short|buy|sell)\\s+([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])\\s*$"
      ]
    },
    "entry_price": {
      "patterns": [
        "\\bavg\\.?\\s*fill\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])",
        "\\bentry\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "exit_price": {
      "patterns": [
        "\\b(?:exit|close|closing)\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "stop_loss": {
      "patterns": [
        "\\bstop\\s*loss\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "take_profit": {
      "patterns": [
        "\\btake\\s*profit\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "net_pnl": {
      "patterns": [
        "\\brealized\\s*(?:p\\s*&\\s*l|pnl|p/l)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])",
        "(?<!realized )\\b(?:p\\s*&\\s*l|pnl|p/l)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "commission": {
      "patterns": [
        "\\bcommission\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    },
    "entry_time": {
      "patterns": [
        "(?m)^\\s*(?:entry\\s*|open\\s*)?time\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "exit_time": {
      "patterns": [
        "\\b(?:close|exit)\\s*time\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    }
  }
}
