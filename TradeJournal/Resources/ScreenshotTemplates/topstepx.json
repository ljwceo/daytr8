{
  "formatVersion": 1,
  "id": "topstepx",
  "name": "TopstepX",
  "priority": 10,
  "keywords": [
    "topstepx",
    "topstep",
    "projectx"
  ],
  "dateOrder": "month_first",
  "fields": {
    "symbol": {
      "patterns": [
        "\\b(?:contract|symbol|instrument)\\b\\s*[:=]?\\s*(/?[A-Z0-9]{2,8})\\b"
      ]
    },
    "direction": {
      "patterns": [
        "\\b(?:type|side|direction)\\b\\s*[:=]?\\s*(long|short|buy|sell)\\b"
      ]
    },
    "quantity": {
      "patterns": [
        "\\b(?:size|qty|quantity)\\b\\s*[:=]?\\s*([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])"
      ]
    },
    "entry_price": {
      "patterns": [
        "\\bentry\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "exit_price": {
      "patterns": [
        "\\bexit\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "entry_time": {
      "patterns": [
        "\\b(?:entry|entered)\\s*(?:time|at)\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "exit_time": {
      "patterns": [
        "\\b(?:exit|exited)\\s*(?:time|at)\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "gross_pnl": {
      "patterns": [
        "(?<!net )\\b(?:gross\\s*)?(?:p\\s*&\\s*l|pnl|p/l)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "net_pnl": {
      "patterns": [
        "\\bnet\\s*(?:p\\s*&\\s*l|pnl|p/l)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "fees": {
      "patterns": [
        "\\b(?:fees?|commissions?)\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    }
  },
  "columns": {
    "symbol": {
      "labels": [
        "symbol",
        "contract",
        "contract name",
        "instrument"
      ]
    },
    "direction": {
      "labels": [
        "type",
        "side",
        "direction"
      ]
    },
    "quantity": {
