{
  "formatVersion": 1,
  "id": "tradovate",
  "name": "Tradovate",
  "priority": 10,
  "keywords": [
    "tradovate",
    "bought timestamp",
    "sold timestamp",
    "paired qty"
  ],
  "dateOrder": "month_first",
  "fields": {
    "symbol": {
      "patterns": [
        "\\b(?:symbol|contract)\\b\\s*[:=]?\\s*([A-Z0-9]{2,8})\\b"
      ]
    },
    "quantity": {
      "patterns": [
        "\\b(?:paired\\s*qty|qty|quantity)\\b\\s*[:=]?\\s*([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])"
      ]
    },
    "buy_price": {
      "patterns": [
        "\\bbuy\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "sell_price": {
      "patterns": [
        "\\bsell\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "buy_time": {
      "patterns": [
        "\\bbought\\s*(?:timestamp|time)\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "sell_time": {
      "patterns": [
        "\\bsold\\s*(?:timestamp|time)\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "gross_pnl": {
      "patterns": [
        "\\b(?:p\\s*&\\s*l|pnl|p/l)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "commission": {
      "patterns": [
        "\\bcomm(?:ission)?s?\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    },
    "fees": {
      "patterns": [
        "\\bfees?\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    }
  }
}
