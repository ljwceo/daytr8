{
  "formatVersion": 1,
  "id": "ninjatrader",
  "name": "NinjaTrader",
  "priority": 10,
  "keywords": [
    "ninjatrader",
    "ninja trader",
    "market pos",
    "cum. net profit"
  ],
  "dateOrder": "month_first",
  "fields": {
    "symbol": {
      "patterns": [
        "\\binstrument\\b\\s*[:=]?\\s*([A-Z0-9]{1,6}(?: [0-9]{2}-[0-9]{2})?)"
      ]
    },
    "direction": {
      "patterns": [
        "\\bmarket\\s*pos(?:ition|\\.)?\\s*[:=]?\\s*(long|short)\\b"
      ]
    },
    "quantity": {
      "patterns": [
        "\\b(?:qty|quantity)\\b\\s*[:=]?\\s*([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])"
      ]
    },
    "entry_price": {
      "patterns": [
        "\\bentry\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "exit_price": {
      "patterns": [
        "\\bexit\\s*price\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "entry_time": {
      "patterns": [
        "\\bentry\\s*time\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "exit_time": {
      "patterns": [
        "\\bexit\\s*time\\b\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)"
      ]
    },
    "stop_loss": {
      "patterns": [
        "\\bstop(?:\\s*loss)?\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "take_profit": {
      "patterns": [
        "\\b(?:profit\\s*)?target\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "gross_pnl": {
      "patterns": [
        "(?<!net )(?<!cum\\. )\\bprofit\\b(?!\\s*target)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "net_pnl": {
      "patterns": [
        "(?<!cum\\. )\\bnet\\s*profit\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "commission": {
      "patterns": [
        "\\bcommission\\b\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    }
  },
  "columns": {
    "symbol": {
      "labels": [
        "instrument"
      ]
    },
    "direction": {
      "labels": [
        "market pos.",
        "market pos",
        "market position"
      ]
    },
    "quantity": {
      "labels": [
        "qty",
        "quantity"
      ]
    },
    "entry_price": {
      "labels": [
        "entry price"
      ]
    },
    "exit_price": {
      "labels": [
        "exit price"
      ]
    },
    "entry_time": {
      "labels": [
        "entry time"
      ]
    },
    "exit_time": {
      "labels": [
        "exit time"
      ]
    },
    "gross_pnl": {
      "labels": [
        "profit"
      ]
    },
    "commission": {
      "labels": [
        "commission"
      ],
      "postProcess": [
        "absolute"
      ]
    },
    "other": {
      "labels": [
        "trade number",
