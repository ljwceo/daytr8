{
  "formatVersion": 1,
  "id": "metatrader",
  "name": "MetaTrader",
  "priority": 10,
  "keywords": [
    "metatrader",
    "mt4",
    "mt5",
    "swap",
    "s / l",
    "t / p",
    "s/l",
    "t/p",
    "→",
    "->"
  ],
  "fields": {
    "symbol": {
      "patterns": [
        "(?m)^\\s*([A-Z0-9.]{3,12})(?:\\s*,\\s*|\\s+)(?:buy|sell)\\b"
      ]
    },
    "direction": {
      "patterns": [
        "(?m)^\\s*[A-Z0-9.]{3,12}(?:\\s*,\\s*|\\s+)(buy|sell)\\b"
      ]
    },
    "quantity": {
      "patterns": [
        "(?m)^\\s*[A-Z0-9.]{3,12}(?:\\s*,\\s*|\\s+)(?:buy|sell)(?:\\s*(?:limit|stop))?\\s+([0-9](?:[0-9.,]*[0-9])?)(?![0-9/:\\-])"
      ]
    },
    "entry_price": {
      "patterns": [
        "(?<![0-9.])([0-9]+\\.[0-9]+)\\s*(?:→|->|➝|>)\\s*([0-9]+\\.[0-9]+)",
        "(?<![0-9.])([0-9]+\\.[0-9]+)\\s*(?:→|->|➝|>|-)?\\s*([0-9]+\\.[0-9]+)\\s+[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\b"
      ],
      "group": 1
    },
    "exit_price": {
      "patterns": [
        "(?<![0-9.])([0-9]+\\.[0-9]+)\\s*(?:→|->|➝|>)\\s*([0-9]+\\.[0-9]+)",
        "(?<![0-9.])([0-9]+\\.[0-9]+)\\s*(?:→|->|➝|>|-)?\\s*([0-9]+\\.[0-9]+)\\s+[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\b"
      ],
      "group": 2
    },
    "stop_loss": {
      "patterns": [
        "\\bs\\s*/\\s*l\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "take_profit": {
      "patterns": [
        "\\bt\\s*/\\s*p\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ]
    },
    "gross_pnl": {
      "patterns": [
        "\\bprofit\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])",
        "(?m)^\\s*[A-Z0-9.]{3,12}(?:\\s*,\\s*|\\s+)(?:buy|sell)\\s+[0-9.]+\\s+([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9]{1,3}(?:[ ,.]?[0-9]{3})*(?:[.,][0-9]+)?\\)?)\\s*$",
        "(?m)(?<![0-9.])[0-9]+\\.[0-9]+[ \\t]*(?:→|->|➝|>)[ \\t]*[0-9]+\\.[0-9]+[ \\t]+([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9]{1,3}(?:[ ,.]?[0-9]{3})*(?:[.,][0-9]+)?\\)?)[ \\t]*$"
      ]
    },
    "commission": {
      "patterns": [
        "\\b(?:commission|charges)\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "absolute"
      ]
    },
    "fees": {
      "patterns": [
        "\\bswap\\s*[:=]?\\s*([+\\-]?\\s?[$€£]?\\s?[+\\-]?\\(?[0-9](?:[0-9.,]*[0-9])?\\)?)(?![0-9/:\\-])"
      ],
      "postProcess": [
        "negate"
      ]
    },
    "entry_time": {
      "patterns": [
        "\\bopen(?:\\s*time)?\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)",
        "([0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)\\s*(?:→|->|➝|>|-)\\s*[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\s+[0-9]{1,2}:[0-9]{2}"
      ]
    },
    "exit_time": {
      "patterns": [
        "\\bclose(?:\\s*time)?\\s*[:=]?\\s*([0-9]{1,4}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4}(?:[ T,]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)?|[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s?[AP]M)?)",
        "(?<![0-9.])[0-9]+\\.[0-9]+\\s*(?:→|->|➝|>|-)?\\s*[0-9]+\\.[0-9]+\\s+([0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)",
        "[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?\\s*(?:→|->|➝|>|-)\\s*([0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}\\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)"
      ]
    }
  }
}
